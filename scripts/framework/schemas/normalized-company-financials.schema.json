{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://modular-stock-framework.local/schemas/normalized-company-financials.schema.json",
  "title": "NormalizedCompanyFinancials",
  "description": "Provider-neutral financial data model bridging Tier 2 Market Data Providers and Tier 3 Analysis Principles across Indian (IN/INR) and US (US/USD) equities and Index ETFs.",
  "type": "object",
  "required": [
    "ticker",
    "name",
    "market",
    "currency",
    "timestamp",
    "market_data"
  ],
  "additionalProperties": false,
  "properties": {
    "ticker": {
      "type": "string",
      "minLength": 1,
      "description": "Canonical exchange ticker symbol (e.g., INFY, AAPL)."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Full legal or display company/fund name."
    },
    "exchange": {
      "type": ["string", "null"],
      "description": "Primary listing exchange (e.g., NSE, BSE, NASDAQ, NYSE)."
    },
    "market": {
      "type": "string",
      "enum": ["IN", "US"],
      "description": "Jurisdiction market code."
    },
    "currency": {
      "type": "string",
      "enum": ["INR", "USD"],
      "description": "Reporting currency ISO 4217 code."
    },
    "unit_scale": {
      "type": "string",
      "enum": ["ABSOLUTE", "CRORES", "MILLIONS", "BILLIONS"],
      "default": "ABSOLUTE",
      "description": "Scale factor for statement monetary figures."
    },
    "sector": {
      "type": ["string", "null"],
      "description": "GICS/standard sector classification."
    },
    "industry": {
      "type": ["string", "null"],
      "description": "Industry sub-classification."
    },
    "timestamp": {
      "type": "string",
      "minLength": 1,
      "description": "ISO 8601 timestamp when the financial snapshot was normalized."
    },
    "is_index_etf": {
      "type": "boolean",
      "default": false,
      "description": "True when the security is a passive Index ETF or broad market fund without single-company GAAP statements."
    },
    "source_provider": {
      "type": ["string", "null"],
      "description": "Identifier of the Tier 2 provider that produced this snapshot (e.g., tickertape)."
    },
    "market_data": {
      "type": "object",
      "required": ["cmp"],
      "additionalProperties": false,
      "properties": {
        "cmp": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Current Market Price per share in reporting currency."
        },
        "market_cap": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0
        },
        "shares_outstanding": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0
        },
        "eps_ttm": {
          "type": ["number", "null"]
        },
        "bvps": {
          "type": ["number", "null"]
        },
        "pe_ttm": {
          "type": ["number", "null"]
        },
        "pb_ttm": {
          "type": ["number", "null"]
        },
        "ev_ebitda": {
          "type": ["number", "null"]
        },
        "dividend_yield_pct": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "beta": {
          "type": ["number", "null"]
        },
        "historical_pe_5y_median": {
          "type": ["number", "null"]
        },
        "historical_pb_5y_median": {
          "type": ["number", "null"]
        },
        "eps_growth_5y_cagr_pct": {
          "type": ["number", "null"]
        },
        "revenue_growth_5y_cagr_pct": {
          "type": ["number", "null"]
        }
      }
    },
    "income_statement": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "revenue": { "type": ["number", "null"] },
        "ebitda": { "type": ["number", "null"] },
        "ebit": { "type": ["number", "null"] },
        "interest_expense": { "type": ["number", "null"] },
        "ebt": { "type": ["number", "null"] },
        "tax_expense": { "type": ["number", "null"] },
        "net_income": { "type": ["number", "null"] },
        "eps": { "type": ["number", "null"] }
      }
    },
    "balance_sheet": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "cash_and_equivalents": { "type": ["number", "null"] },
        "accounts_receivable": { "type": ["number", "null"] },
        "inventory": { "type": ["number", "null"] },
        "total_current_assets": { "type": ["number", "null"] },
        "goodwill": { "type": ["number", "null"] },
        "intangible_assets": { "type": ["number", "null"] },
        "total_assets": { "type": ["number", "null"] },
        "short_term_debt": { "type": ["number", "null"] },
        "long_term_debt": { "type": ["number", "null"] },
        "total_debt": { "type": ["number", "null"] },
        "debt_maturing_24m": { "type": ["number", "null"] },
        "total_current_liabilities": { "type": ["number", "null"] },
        "total_liabilities": { "type": ["number", "null"] },
        "retained_earnings": { "type": ["number", "null"] },
        "total_equity": { "type": ["number", "null"] }
      }
    },
    "cash_flow": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "operating_cash_flow": { "type": ["number", "null"] },
        "capital_expenditure": { "type": ["number", "null"] },
        "maintenance_capex": { "type": ["number", "null"] },
        "free_cash_flow": { "type": ["number", "null"] },
        "stock_based_compensation": { "type": ["number", "null"] },
        "dividends_paid": { "type": ["number", "null"] },
        "share_repurchases": { "type": ["number", "null"] }
      }
    },
    "forensics": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "promoter_holding_pct": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 100
        },
        "promoter_pledge_pct": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 100
        },
        "promoter_holding_qoq_delta_pct": {
          "type": ["number", "null"]
        },
        "related_party_transactions_pct": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "auditor_resignation_flag": {
          "type": ["boolean", "null"]
        },
        "qualified_opinion_flag": {
          "type": ["boolean", "null"]
        },
        "beneish_m_score": {
          "type": ["number", "null"]
        },
        "sloan_accrual_ratio": {
          "type": ["number", "null"]
        },
        "dso_yoy_expansion_pct": {
          "type": ["number", "null"]
        },
        "inventory_growth_vs_sales_delta_pct": {
          "type": ["number", "null"]
        },
        "surveillance_stage": {
          "type": ["string", "null"]
        }
      }
    }
  },
  "if": {
    "properties": {
      "is_index_etf": { "const": true }
    },
    "required": ["is_index_etf"]
  },
  "else": {
    "required": [
      "income_statement",
      "balance_sheet",
      "cash_flow",
      "forensics"
    ],
    "properties": {
      "market_data": {
        "required": ["cmp", "shares_outstanding"],
        "properties": {
          "shares_outstanding": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      },
      "income_statement": {
        "type": "object",
        "required": ["revenue", "net_income"]
      },
      "balance_sheet": {
        "type": "object",
        "required": ["total_assets", "total_liabilities", "total_equity"]
      },
      "cash_flow": {
        "type": "object",
        "required": ["operating_cash_flow"]
      },
      "forensics": {
        "type": "object"
      }
    }
  }
}

