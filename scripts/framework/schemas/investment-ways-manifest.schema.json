{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tickertape-indmoney-tracking.local/schemas/investment-ways-manifest.schema.json",
  "title": "InvestmentWaysManifest",
  "description": "Declarative manifest mapping broker accounts, market data providers, gatekeepers, and valuation principles to partitioned Investment Ways.",
  "type": "object",
  "required": [
    "version",
    "accounts",
    "data_providers",
    "gatekeepers",
    "analysis_principles",
    "investment_ways"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "accounts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["broker", "currency", "skill"],
        "additionalProperties": false,
        "properties": {
          "broker": { "type": "string", "minLength": 1 },
          "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
          "skill": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "active": { "type": "boolean", "default": true }
        }
      }
    },
    "data_providers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["skill", "markets"],
        "additionalProperties": false,
        "properties": {
          "skill": { "type": "string", "minLength": 1 },
          "markets": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "description": { "type": "string" }
        }
      }
    },
    "gatekeepers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["skill"],
        "additionalProperties": false,
        "properties": {
          "skill": { "type": "string", "minLength": 1 },
          "description": { "type": "string" }
        }
      }
    },
    "analysis_principles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["skill", "category"],
        "additionalProperties": false,
        "properties": {
          "skill": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "description": { "type": "string" }
        }
      }
    },
    "investment_ways": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "title",
          "skill",
          "base_currency",
          "accounts",
          "data_provider",
          "gatekeepers",
          "analysis_principles",
          "weights"
        ],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "skill": { "type": "string", "minLength": 1 },
          "base_currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
          "accounts": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "data_provider": { "type": "string", "minLength": 1 },
          "gatekeepers": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "analysis_principles": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "weights": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            }
          }
        }
      }
    }
  }
}

