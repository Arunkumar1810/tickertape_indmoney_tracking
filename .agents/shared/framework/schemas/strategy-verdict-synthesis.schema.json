{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://modular-stock-framework.local/schemas/strategy-verdict-synthesis.schema.json",
  "title": "StrategyVerdictSynthesis",
  "description": "Standardized Tier 4 Consolidated Strategy Verdict Synthesis & Asymmetric Downside Guardrail Contract across gatekeeper and valuation pillars.",
  "type": "object",
  "required": [
    "strategy_id",
    "timestamp",
    "eval_date",
    "summary",
    "portfolio_verdicts",
    "allocations"
  ],
  "additionalProperties": false,
  "properties": {
    "strategy_id": {
      "type": "string",
      "minLength": 1,
      "description": "Identifier of the Investment Way matching config/investment_ways.yaml (e.g. fundamental_lts)."
    },
    "timestamp": {
      "type": "string",
      "minLength": 1,
      "description": "ISO 8601 timestamp when the synthesis was performed."
    },
    "eval_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Valuation cutoff date (YYYY-MM-DD)."
    },
    "summary": {
      "type": "object",
      "required": [
        "portfolio_health_score",
        "total_positions",
        "disqualified_count",
        "needs_review_count",
        "approved_count",
        "capital_at_risk"
      ],
      "additionalProperties": false,
      "properties": {
        "portfolio_health_score": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 100.0,
          "description": "Weighted average composite health score across non-disqualified strategy assets."
        },
        "total_positions": {
          "type": "integer",
          "minimum": 0,
          "description": "Total count of securities evaluated."
        },
        "disqualified_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of assets immediately disqualified by the forensic governance gatekeeper."
        },
        "needs_review_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of assets flagged by the asymmetric downside guardrail (any Strong Sell signal)."
        },
        "approved_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of assets passing both gatekeeper and downside guardrails (HOLD, BUY, STRONG_BUY)."
        },
        "capital_at_risk": {
          "type": "number",
          "minimum": 0.0,
          "description": "Total monetary capital held in DISQUALIFIED or NEEDS_REVIEW assets in strategy base currency."
        }
      }
    },
    "portfolio_verdicts": {
      "type": "array",
      "description": "Synthesized decision and pillar breakdown for each portfolio security.",
      "items": {
        "type": "object",
        "required": [
          "ticker",
          "synthesized_score",
          "synthesized_stance",
          "is_disqualified",
          "guardrail_triggered",
          "gatekeeper_verdict",
          "pillar_verdicts",
          "notes",
          "recommended_allocation_pct"
        ],
        "additionalProperties": false,
        "properties": {
          "ticker": {
            "type": "string",
            "minLength": 1,
            "description": "Security ticker symbol."
          },
          "name": {
            "type": "string",
            "description": "Company name."
          },
          "market": {
            "type": "string",
            "enum": ["IN", "US"],
            "description": "Domestic or foreign market code."
          },
          "synthesized_score": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 100.0,
            "description": "Weighted composite score across active valuation pillars (0.0 if disqualified)."
          },
          "synthesized_stance": {
            "type": "string",
            "enum": [
              "STRONG_BUY",
              "BUY",
              "HOLD",
              "REDUCE",
              "STRONG_SELL",
              "DISQUALIFIED",
              "NEEDS_REVIEW"
            ],
            "description": "Authoritative strategy stance after gatekeeper and downside guardrail evaluation."
          },
          "is_disqualified": {
            "type": "boolean",
            "description": "True if the security was vetoed by the forensic governance gatekeeper."
          },
          "guardrail_triggered": {
            "type": "boolean",
            "description": "True if the asymmetric downside guardrail intercepted a Strong Sell signal."
          },
          "gatekeeper_verdict": {
            "type": "object",
            "required": ["principle", "stance", "is_veto", "score", "red_flags"],
            "additionalProperties": false,
            "properties": {
              "principle": {
                "type": "string",
                "enum": ["forensic_governance"]
              },
              "stance": {
                "type": "string",
                "enum": ["PASS", "FLAG", "VETO_DISQUALIFIED"]
              },
              "is_veto": {
                "type": "boolean"
              },
              "score": {
                "type": "number",
                "minimum": 0.0,
                "maximum": 100.0
              },
              "red_flags": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          },
          "pillar_verdicts": {
            "type": "object",
            "description": "Breakdown of individual valuation principle scores, stances, and assigned weights.",
            "additionalProperties": {
              "type": "object",
              "required": ["score", "stance", "weight", "weighted_score", "red_flags"],
              "additionalProperties": false,
              "properties": {
                "score": { "type": "number", "minimum": 0.0, "maximum": 100.0 },
                "stance": {
                  "type": "string",
                  "enum": ["STRONG_BUY", "BUY", "HOLD", "REDUCE", "STRONG_SELL"]
                },
                "weight": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
                "weighted_score": { "type": "number", "minimum": 0.0, "maximum": 100.0 },
                "red_flags": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          },
          "notes": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Explanatory notes detailing veto triggers, downside guardrail warnings, or ceiling capping."
          },
          "recommended_allocation_pct": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 100.0,
            "description": "Recommended portfolio target allocation percentage."
          }
        }
      }
    },
    "allocations": {
      "type": "array",
      "description": "Target capital allocation rebalancing recommendations.",
      "items": {
        "type": "object",
        "required": [
          "ticker",
          "current_weight_pct",
          "recommended_weight_pct",
          "action"
        ],
        "additionalProperties": false,
        "properties": {
          "ticker": { "type": "string", "minLength": 1 },
          "current_weight_pct": { "type": "number", "minimum": 0.0, "maximum": 100.0 },
          "recommended_weight_pct": { "type": "number", "minimum": 0.0, "maximum": 100.0 },
          "action": {
            "type": "string",
            "enum": [
              "MAINTAIN",
              "INCREASE",
              "TRIM",
              "LIQUIDATE_IMMEDIATELY",
              "MANUAL_REVIEW"
            ]
          }
        }
      }
    }
  }
}

