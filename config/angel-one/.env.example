# Copy to .env and replace with your Angel One SmartAPI credentials
ANGEL_ONE_API_KEY=your_api_key_here
ANGEL_ONE_CLIENT_CODE=your_client_code_here
ANGEL_ONE_PASSWORD=your_trading_pin_here
ANGEL_ONE_TOTP_SECRET=your_totp_secret_here
# Optional server configuration overrides:
# ANGELONE_MCP_DIR=
# ANGELONE_MCP_TRANSPORT=stdio
# ANGELONE_MCP_URL=http://localhost:8000/mcp

