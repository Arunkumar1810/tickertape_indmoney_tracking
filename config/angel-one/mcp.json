{
  "_comment": "Angel One SmartAPI MCP server configuration.",
  "server": "angelone",
  "transport": "stdio",
  "timeoutMs": 30000,
  "stdio": {
    "command": "uv",
    "args": ["run", "--quiet", "--project", "${ANGELONE_MCP_DIR}", "python", "${ANGELONE_MCP_DIR}/server.py"],
    "cwd": "${ANGELONE_MCP_DIR}"
  },
  "passEnv": [
    "ANGEL_ONE_API_KEY",
    "ANGEL_ONE_CLIENT_CODE",
    "ANGEL_ONE_PASSWORD",
    "ANGEL_ONE_TOTP_SECRET"
  ],
  "http": {
    "endpoint": "http://localhost:8000/mcp"
  }
}

